{
  "description": "百合生长模型数据监测 - 物理极限表（各时期各维度指标的合理物理范围）",
  "version": "1.0",
  "source_file": "纯物理极限表.xlsx",
  "periods": ["萌芽期", "展叶期", "孕蕾期", "开花期"],
  "dimensions": ["环境", "土壤", "生长状况"],
  "limits": {
    "萌芽期": {
      "环境": {
        "昼温": {"unit": "℃", "min": -10.0, "max": 33.0},
        "夜温": {"unit": "℃", "min": -12.0, "max": 33.0},
        "湿度": {"unit": "%", "min": 0.0, "max": 100.0},
        "光照强度": {"unit": "lx", "min": 0.0, "max": 100000.0}
      },
      "土壤": {
        "pH值": {"unit": "pH", "min": 4.5, "max": 8.5},
        "EC值": {"unit": "ms/cm", "min": 0.0, "max": 1.5}
      }
    },
    "展叶期": {
      "环境": {
        "昼温": {"unit": "℃", "min": -10.0, "max": 33.0},
        "夜温": {"unit": "℃", "min": -12.0, "max": 33.0},
        "湿度": {"unit": "%", "min": 0.0, "max": 100.0},
        "光照强度": {"unit": "lx", "min": 0.0, "max": 100000.0}
      },
      "土壤": {
        "pH值": {"unit": "pH", "min": 4.5, "max": 8.5},
        "EC值": {"unit": "ms/cm", "min": 0.0, "max": 1.5}
      },
      "生长状况": {
        "株高": {"unit": "cm", "min": 20.0, "max": 150.0},
        "茎粗": {"unit": "cm", "min": 0.29, "max": 1.02},
        "叶长": {"unit": "cm", "min": 5.0, "max": 25.0},
        "叶宽": {"unit": "cm", "min": 0.29, "max": 3.59}
      }
    },
    "孕蕾期": {
      "环境": {
        "昼温": {"unit": "℃", "min": -10.0, "max": 33.0},
        "夜温": {"unit": "℃", "min": -12.0, "max": 33.0},
        "湿度": {"unit": "%", "min": 0.0, "max": 100.0},
        "光照强度": {"unit": "lx", "min": 0.0, "max": 100000.0}
      },
      "土壤": {
        "pH值": {"unit": "pH", "min": 4.5, "max": 8.5},
        "EC值": {"unit": "ms/cm", "min": 0.0, "max": 1.5}
      },
      "生长状况": {
        "株高": {"unit": "cm", "min": 20.0, "max": 150.0},
        "茎粗": {"unit": "cm", "min": 0.29, "max": 1.02},
        "花蕾长": {"unit": "cm", "min": 2.0, "max": 15.0},
        "花蕾数": {"unit": "个", "min": 1.0, "max": 20.0}
      }
    },
    "开花期": {
      "环境": {
        "昼温": {"unit": "℃", "min": -10.0, "max": 33.0},
        "夜温": {"unit": "℃", "min": -12.0, "max": 33.0},
        "湿度": {"unit": "%", "min": 0.0, "max": 100.0},
        "光照强度": {"unit": "lx", "min": 0.0, "max": 100000.0}
      },
      "土壤": {
        "pH值": {"unit": "pH", "min": 4.5, "max": 8.5},
        "EC值": {"unit": "ms/cm", "min": 0.0, "max": 1.5}
      },
      "生长状况": {
        "花蕾开放数": {"unit": "个", "min": 1.0, "max": 20.0},
        "花径": {"unit": "cm", "min": 4.0, "max": 23.2}
      }
    }
  }
